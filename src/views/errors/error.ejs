<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f7fb" />
    <title><%= statusCode %> · <%= title %> | GitHub Issue Analyzer</title>
    <style>
      :root {
        color-scheme: light;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
          "Segoe UI", sans-serif;
        color: #172033;
        background: #f5f7fb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        margin: 0;
        display: flex;
        flex-direction: column;
      }

      a {
        color: inherit;
      }

      .topbar {
        width: 100%;
        border-bottom: 1px solid #e4e9f2;
        background: #fff;
      }

      .nav {
        width: min(1080px, calc(100% - 40px));
        min-height: 68px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: -0.02em;
      }

      .brand-mark {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #e9edff;
        color: #4054c5;
        font-size: 17px;
      }

      .nav-link {
        color: #566178;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
      }

      .nav-link:hover,
      .text-link:hover {
        color: #4054c5;
      }

      main {
        width: min(680px, calc(100% - 40px));
        margin: auto;
        padding: 72px 0;
      }

      .error-card {
        padding: clamp(28px, 7vw, 56px);
        border: 1px solid #e4e9f2;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 18px 50px rgb(34 49 86 / 7%);
      }

      .status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 11px;
        border: 1px solid #e5e9fb;
        border-radius: 999px;
        background: #f5f6ff;
        color: #4054c5;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      h1 {
        margin: 22px 0 12px;
        font-size: clamp(30px, 6vw, 42px);
        line-height: 1.12;
        letter-spacing: -0.045em;
      }

      .message {
        margin: 0;
        color: #48536a;
        font-size: 17px;
        line-height: 1.65;
      }

      .guidance {
        margin: 22px 0 0;
        padding: 16px 18px;
        border-left: 3px solid #7c89e6;
        border-radius: 0 10px 10px 0;
        background: #f7f8ff;
        color: #58627a;
        font-size: 14px;
        line-height: 1.6;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 18px;
        margin-top: 30px;
      }

      .button {
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        border: 1px solid #4054c5;
        border-radius: 10px;
        background: #4054c5;
        color: #fff;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
        transition:
          background 140ms ease,
          transform 140ms ease;
      }

      .button:hover {
        transform: translateY(-1px);
        background: #3346b2;
      }

      .text-link {
        color: #58627a;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
      }

      footer {
        padding: 20px;
        color: #8790a3;
        font-size: 12px;
        text-align: center;
      }

      @media (max-width: 520px) {
        .nav {
          width: calc(100% - 32px);
        }

        main {
          width: calc(100% - 32px);
          padding: 36px 0;
        }

        .actions {
          align-items: stretch;
          flex-direction: column;
          gap: 14px;
        }

        .actions .text-link {
          text-align: center;
        }
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">
          <span class="brand-mark" aria-hidden="true">⌘</span>
          <span>GitHub Issue Analyzer</span>
        </a>
        <% if (isAuthenticated) { %>
          <a class="nav-link" href="/">Your dashboard</a>
        <% } else { %>
          <a class="nav-link" href="/auth/login">Sign in</a>
        <% } %>
      </nav>
    </header>

    <main>
      <section class="error-card" aria-labelledby="error-title">
        <div class="status">
          <span aria-hidden="true">●</span>
          Error <%= statusCode %>
        </div>
        <h1 id="error-title"><%= title %></h1>
        <p class="message"><%= message %></p>
        <p class="guidance"><%= guidance %></p>
        <div class="actions">
          <% if (isAuthenticated) { %>
            <a class="button" href="/">Go to your dashboard</a>
            <a class="text-link" href="/repo">Add a repository</a>
          <% } else { %>
            <a class="button" href="/auth/login">Sign in</a>
            <a class="text-link" href="/">Try the home page</a>
          <% } %>
        </div>
      </section>
    </main>

    <footer>GitHub Issue Analyzer · Issue monitoring made simpler</footer>
  </body>
</html>
