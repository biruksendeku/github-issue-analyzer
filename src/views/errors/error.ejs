<%- include("../partials/head", { pageTitle: `${statusCode} · ${title}` }) %>
<body>
  <%- include("../partials/header", {
    isAuthenticated,
    showLoginLink: !isAuthenticated,
    showSignupLink: false
  }) %>

  <main>
    <section class="card error-card" aria-labelledby="error-title">
      <div class="status">
        <span aria-hidden="true">●</span>
        Error <%= statusCode %>
      </div>
      <h1 id="error-title"><%= title %></h1>
      <p class="message"><%= message %></p>
      <p class="guidance"><%= guidance %></p>
      <div class="actions">
        <% if (isAuthenticated) { %>
          <a class="button" href="/">Go to your dashboard</a>
          <a class="text-link" href="/repo">Add a repository</a>
        <% } else { %>
          <a class="button" href="/auth/login">Sign in</a>
          <a class="text-link" href="/">Try the home page</a>
        <% } %>
      </div>
    </section>
  </main>

  <%- include("../partials/footer") %>
</body>
</html>
