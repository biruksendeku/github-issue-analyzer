<%- include("partials/head", { pageTitle: "Sign in" }) %>
<body>
  <%- include("partials/header", {
    isAuthenticated: false,
    showLoginLink: false,
    showSignupLink: true
  }) %>

  <main>
    <section class="page-heading">
      <p class="eyebrow">Welcome back</p>
      <h1>Sign in to your workspace</h1>
      <p class="subheading">
        Pick up where you left off and see what’s new in your tracked repos.
      </p>
    </section>

    <section class="card">
      <form class="form" action="/auth/login" method="post">
        <div class="field">
          <label for="email">Email address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="you@example.com"
            autocomplete="email"
            required
          />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Enter your password"
            autocomplete="current-password"
            required
          />
        </div>
        <button class="button" type="submit">Sign in</button>
      </form>

      <div class="divider">or</div>
      <a class="button button-secondary" href="/auth/google">
        Continue with Google
      </a>
      <p class="form-note form-note-spaced">
        New here? <a class="inline-link" href="/auth/signup">Create an account</a>
      </p>
    </section>
  </main>

  <%- include("partials/footer") %>
</body>
</html>
