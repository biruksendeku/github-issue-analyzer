<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Repo Result</title>
  </head>
  <body>
    <h1>Repo Result For <%= username %></h1>
    <% if (latestRepo) { %>
      <p>
        <a href="<%= latestRepo.html_url %>"><%= latestRepo.name %></a>
      </p>
    <% } else { %>
      <p>No public repositories found.</p>
    <% } %>
  </body>
</html>
